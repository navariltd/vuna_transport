{
 "custom_fields": [
  {
   "dt": "Address",
   "fieldname": "vuna_transport_planning_section",
   "fieldtype": "Section Break",
   "insert_after": "disabled",
   "label": "Transport Planning",
   "module": "Vuna Transport"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_delivery_zone",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "insert_after": "vuna_transport_planning_section",
   "label": "Delivery Zone",
   "module": "Vuna Transport",
   "options": "Transport Zone"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_coordinates_section",
   "fieldtype": "Section Break",
   "insert_after": "vuna_delivery_zone",
   "label": "Delivery Coordinates",
   "module": "Vuna Transport"
  },
  {
   "description": "Latitude must be between -90 and 90.",
   "dt": "Address",
   "fieldname": "vuna_latitude",
   "fieldtype": "Float",
   "insert_after": "vuna_coordinates_section",
   "label": "Latitude",
   "module": "Vuna Transport",
   "precision": "8"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_coordinates_column",
   "fieldtype": "Column Break",
   "insert_after": "vuna_latitude",
   "module": "Vuna Transport"
  },
  {
   "description": "Longitude must be between -180 and 180.",
   "dt": "Address",
   "fieldname": "vuna_longitude",
   "fieldtype": "Float",
   "insert_after": "vuna_coordinates_column",
   "label": "Longitude",
   "module": "Vuna Transport",
   "precision": "8"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_use_device_location",
