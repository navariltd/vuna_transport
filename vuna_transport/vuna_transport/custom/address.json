   "insert_after": "vuna_longitude",
   "label": "Use Device Location",
   "module": "Vuna Transport"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_location_section",
   "fieldtype": "Section Break",
   "insert_after": "vuna_use_device_location",
   "label": "Delivery Map Pin",
   "module": "Vuna Transport"
  },
  {
   "description": "The map pin and coordinates are synchronized automatically.",
   "dt": "Address",
   "fieldname": "vuna_location",
   "fieldtype": "Geolocation",
   "insert_after": "vuna_location_section",
   "label": "Delivery Location",
   "module": "Vuna Transport"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_delivery_window_section",
   "fieldtype": "Section Break",
   "insert_after": "vuna_location",
   "label": "Delivery Window & Access",
   "module": "Vuna Transport"
  },
  {
   "dt": "Address",
   "fieldname": "vuna_preferred_delivery_from",
   "fieldtype": "Time",
