{
 "custom_fields": [
  {
   "dt": "Vehicle",
   "fieldname": "vuna_transport_section",
   "fieldtype": "Section Break",
   "insert_after": "company",
   "label": "Transport Planning",
   "module": "Vuna Transport"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_vehicle_category",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "insert_after": "vuna_transport_section",
   "label": "Vehicle Category",
   "module": "Vuna Transport",
   "options": "Vehicle Category",
   "reqd": 1
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_vehicle_model",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "insert_after": "vuna_vehicle_category",
   "label": "Vehicle Model",
   "module": "Vuna Transport",
   "options": "Vehicle Model"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_transport_column",
   "fieldtype": "Column Break",
   "insert_after": "vuna_vehicle_model",
   "module": "Vuna Transport"
  },
  {
   "default": "1",
   "dt": "Vehicle",
   "fieldname": "vuna_transport_enabled",
   "fieldtype": "Check",
   "in_standard_filter": 1,
   "insert_after": "vuna_transport_column",
   "label": "Transport Enabled",
   "module": "Vuna Transport"
  },
  {
   "default": "Company",
   "dt": "Vehicle",
   "fieldname": "vuna_vehicle_owner",
   "fieldtype": "Select",
   "in_standard_filter": 1,
   "insert_after": "vuna_transport_enabled",
   "label": "Vehicle Owner",
   "module": "Vuna Transport",
   "options": "Company\nSupplier"
  },
  {
   "description": "ERPNext Asset used as the maintenance and repair authority for this physical vehicle.",
   "dt": "Vehicle",
   "fieldname": "vuna_asset",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "insert_after": "vuna_vehicle_owner",
   "label": "Asset",
   "module": "Vuna Transport",
   "options": "Asset",
   "depends_on": "eval:doc.vuna_transport_enabled && doc.vuna_vehicle_owner == 'Company'",
   "mandatory_depends_on": "eval:doc.vuna_transport_enabled && doc.vuna_vehicle_owner == 'Company'"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_supplier",
   "fieldtype": "Link",
   "insert_after": "vuna_asset",
   "label": "Supplier",
   "depends_on": "eval:doc.vuna_vehicle_owner == 'Supplier'",
   "mandatory_depends_on": "eval:doc.vuna_vehicle_owner == 'Supplier'",
   "module": "Vuna Transport",
   "options": "Supplier"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_operational_status_section",
   "fieldtype": "Section Break",
   "insert_after": "vuna_supplier",
   "label": "Operational Availability",
   "module": "Vuna Transport"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_operational_status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "insert_after": "vuna_operational_status_section",
   "label": "Operational Status",
   "module": "Vuna Transport",
   "options": "\nAvailable\nAllocated\nLoading\nReady for Dispatch\nIn Trip\nUnder Maintenance\nUnavailable",
   "read_only": 1
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_dispatch_eligible",
   "fieldtype": "Check",
   "in_standard_filter": 1,
   "insert_after": "vuna_operational_status",
   "label": "Dispatch Eligible",
   "module": "Vuna Transport",
   "read_only": 1
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_operational_status_column",
   "fieldtype": "Column Break",
   "insert_after": "vuna_dispatch_eligible",
   "module": "Vuna Transport"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_status_updated_at",
   "fieldtype": "Datetime",
   "insert_after": "vuna_operational_status_column",
   "label": "Status Last Evaluated At",
   "module": "Vuna Transport",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "dt": "Vehicle",
   "fieldname": "vuna_operational_details_section",
   "fieldtype": "Section Break",
   "insert_after": "vuna_status_updated_at",
   "label": "Operational Status Details",
   "module": "Vuna Transport"
  },
  {
   "dt": "Vehicle",
   "fieldname": "vuna_operational_status_html",
   "fieldtype": "HTML",
   "insert_after": "vuna_operational_details_section",
   "label": "Operational Status",
   "module": "Vuna Transport"
  }
 ],
 "custom_perms": [],
 "doctype": "Vehicle",
 "links": [],
 "property_setters": [
  {
   "doctype_or_field": "DocField",
   "doc_type": "Vehicle",
   "field_name": "make",
   "module": "Vuna Transport",
   "property": "hidden",
   "property_type": "Check",
   "value": "1"
  },
  {
   "doctype_or_field": "DocField",
   "doc_type": "Vehicle",
   "field_name": "make",
   "module": "Vuna Transport",
   "property": "reqd",
   "property_type": "Check",
   "value": "0"
  },
  {
   "doctype_or_field": "DocField",
   "doc_type": "Vehicle",
   "field_name": "model",
   "module": "Vuna Transport",
   "property": "hidden",
   "property_type": "Check",
   "value": "1"
  },
  {
   "doctype_or_field": "DocField",
   "doc_type": "Vehicle",
   "field_name": "model",
   "module": "Vuna Transport",
   "property": "reqd",
   "property_type": "Check",
   "value": "0"
  }
 ],
 "sync_on_migrate": 1
}
